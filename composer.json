{
    "name": "karsjen/stateless-queue",
    "description": "Push-based Laravel queue for stateless runtimes. Publishes jobs to Google Cloud Pub/Sub or AWS SNS and executes them from a signed webhook — no queue worker required.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "queue",
        "pubsub",
        "sns",
        "google-cloud",
        "aws",
        "webhook",
        "stateless",
        "serverless",
        "cloud-run",
        "push-queue"
    ],
    "homepage": "https://github.com/KarsjenKoop/stateless-queue",
    "authors": [
        {
            "name": "Karsjen Koop",
            "email": "karsjen@kas-ai.com"
        }
    ],
    "support": {
        "issues": "https://github.com/KarsjenKoop/stateless-queue/issues",
        "source": "https://github.com/KarsjenKoop/stateless-queue",
        "docs": "https://github.com/KarsjenKoop/stateless-queue#readme"
    },
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "laravel/framework": "^10.0|^11.0|^12.0|^13.0",
        "google/cloud-pubsub": "^2.0",
        "aws/aws-sdk-php": "^3.0",
        "google/auth": "^1.50",
        "phpseclib/phpseclib": "^3.0",
        "aws/aws-php-sns-message-validator": "^1.10"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Karsjen\\StatelessQueue\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Karsjen\\StatelessQueue\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Karsjen\\StatelessQueue\\StatelessQueueServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "phpunit --exclude-group e2e",
        "test:all": "phpunit",
        "test:e2e": "phpunit --group e2e"
    },
    "scripts-descriptions": {
        "test": "Run the fast suite (unit + feature, no external services).",
        "test:all": "Run every test, including E2E. Emulators must already be running.",
        "test:e2e": "Run only the E2E group against the Pub/Sub emulator and LocalStack."
    },
    "config": {
        "sort-packages": true
    }
}
