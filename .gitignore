# Terraform working files. At the repository root, not only inside the example:
# an untracked examples/ tree survives a branch switch while the .gitignore
# inside it does not, so `git add -A` on a branch that has no examples/
# directory will happily stage a 114 MB provider binary and a state file
# containing the generated dispatch token.
**/.terraform/
**/.terraform.lock.hcl
**/*.tfstate
**/*.tfstate.*
**/*.tfplan
**/terraform.tfvars
