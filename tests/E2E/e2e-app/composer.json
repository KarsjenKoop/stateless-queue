{
    "name": "karsjen/stateless-queue-e2e-app",
    "type": "project",
    "description": "Minimal Laravel app for stateless-queue E2E (real push)",
    "require": {
        "php": "^8.5",
        "laravel/framework": "^13.0",
        "karsjen/stateless-queue": "*"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../..",
            "options": {
                "symlink": true
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Karsjen\\StatelessQueue\\Tests\\Support\\": "../../Support/"
        }
    },
    "config": {
        "optimize-autoloader": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0"
    }
    
}
